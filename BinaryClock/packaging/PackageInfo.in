name binaryclock_screensaver
version @VERSION@-@REVISION@
architecture @ARCHITECTURE@

summary "Binary-coded decimal clock screen saver"
description "BinaryClock is a native Haiku screen saver that displays the current time as binary-coded decimal LEDs, with optional animated ttfx effects."
vendor "BinaryClock contributors"
packager "BinaryClock contributors"

copyrights {
	"2026 BinaryClock contributors"
	"2026 ttfx-text contributors"
	"2026 ttfx-time contributors"
	"2026 ttfx-haiku contributors"
	"2026 37signals / omacom-io"
	"2023 ChrisBuilds"
}

licenses {
	"MIT"
}

provides {
	binaryclock_screensaver = @VERSION@
}

requires {
	haiku
}
