resource app_signature "application/x-vnd.TTFXTimeScreenSaver";

resource app_version {
	major = 1,
	middle = 0,
	minor = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "ttfx-time screen saver",
	long_info = "ttfx-time 1.0.0, native text effects clock for Haiku"
};

resource app_flags B_SINGLE_LAUNCH;
