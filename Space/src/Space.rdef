resource app_signature "application/x-vnd.SpaceScreenSaver";

resource app_version {
	major = 1,
	middle = 3,
	minor = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "Space screen saver",
	long_info = "Space 1.3.0, based on the original by David Enderson"
};

resource app_flags B_SINGLE_LAUNCH;
