resource app_signature "application/x-vnd.SubstrateScreenSaver";

resource app_version {
	major = 1,
	middle = 1,
	minor = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "Substrate screen saver",
	long_info = "Substrate 1.1.0, ported from XScreenSaver by Josef Gajdusek"
};

resource app_flags B_SINGLE_LAUNCH;
