name substrate_screensaver
version @VERSION@-@REVISION@
architecture @ARCHITECTURE@

summary "Crystalline crack-and-sand screen saver"
description "Substrate is a native Haiku screen saver that grows intersecting straight and circular cracks, depositing coloured sand into an evolving crystalline pattern."
vendor "Substrate contributors"
packager "Substrate contributors"

copyrights {
	"2014 Josef Gajdusek"
}

licenses {
	"MIT"
}

provides {
	substrate_screensaver = @VERSION@
}

requires {
	haiku
}
