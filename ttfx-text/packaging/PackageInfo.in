name ttfx_text_screensaver
version @VERSION@-@REVISION@
architecture @ARCHITECTURE@

summary "Custom animated block-text screen saver"
description "ttfx-text is a native Haiku screen saver that displays configurable solid-block text and cycles through effects adapted from ttfx-haiku and the Omarchy screensaver."
vendor "ttfx-text contributors"
packager "ttfx-text contributors"

copyrights {
	"2026 ttfx-text contributors"
	"2026 ttfx-haiku contributors"
	"2026 37signals / omacom-io"
	"2023 ChrisBuilds"
}

licenses {
	"MIT"
}

provides {
	ttfx_text_screensaver = @VERSION@
}

requires {
	haiku
}
